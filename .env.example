# ─── Database ─────────────────────────────────────────────
# 런타임 쿼리용 (Supavisor Transaction mode, port 6543)
# 예: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=""

# 마이그레이션/스키마 변경용 (DB 직접 연결, port 5432)
# 예: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DIRECT_DATABASE_URL=""

NEXT_PUBLIC_API_URL="http://localhost:3000"

# ─── Better Auth ──────────────────────────────────────────
# 세션 암호화 시크릿 (32자 이상): openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""

# ─── OAuth: Google ────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── OAuth: Kakao ─────────────────────────────────────────
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# ─── OAuth: Naver ─────────────────────────────────────────
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# ─── API ──────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# ─── Misc ─────────────────────────────────────────────────
# CI 빌드 시 환경변수 검증 건너뛰기
SKIP_ENV_VALIDATION="true"

# ─── Web Push (VAPID) ─────────────────────────────────────
# `npx web-push generate-vapid-keys`로 생성
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# mailto: 또는 https URL (운영자 연락처)
VAPID_SUBJECT="mailto:you@example.com"
# 서버 VAPID_PUBLIC_KEY와 동일 값
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
